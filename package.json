{
  "name": "myapp",
  "version": "1.0.0",
  "description": "Multi-Platform App",
  "author": "Web2App Builder",
  "repository": "https://github.com/Akk20045/my-clean-app------------------",
  "main": "main.js",
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/android": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "esbuild": "^0.20.0",
    "jszip": "^3.10.1",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.mycompany.myapp",
    "productName": "تحصيل",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon-512.png"
    },
    "files": [
      "main.js",
      "www/**/*",
      "assets/**/*",
      "package.json"
    ]
  }
}